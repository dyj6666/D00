# ============================================================
# D00 仓库统一忽略规则
# 原则：只忽略构建产物/临时文件；源码与工程配置
#       （.uvprojx / .sct / .ioc / 启动文件）一律保留提交。
# 注意：gitignore 不支持行尾注释，注释一律单独成行。
# ============================================================

# ---------- 通用 / 编辑器 / 系统 ----------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# ---------- Keil / uVision 构建产物 ----------
# 用户 GUI 布局
*.uvguix.*
# 用户本地选项（调试器设置因人而异）
*.uvoptx
*.scvd
*.crf
*.o
*.d
*.axf
*.dep
*.htm
*.lnp
*.lst
*.map
*.build_log.htm
*.bak
*.hex
MDK-ARM/Output/
**/MDK-ARM/**/*.bin

# ---------- GCC / CMake ----------
build/
build-*/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.elf

# ---------- Python / PyInstaller ----------
__pycache__/
*.pyc
*.pyo
*.pyz
*.toc
*.pkg
*.egg-info/
dist/
temp_secure.bin

# ---------- 二进制产物（全部由构建生成） ----------
*.bin
*.exe

# ---------- 日志与临时 ----------
*.log
*.tmp
