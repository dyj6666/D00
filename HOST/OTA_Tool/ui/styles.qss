/* ================================================================
 * D00 OTA 升级中心 · 亮色主题 v4.0
 * 浅蓝灰底 / 白卡片 / 蓝紫主色 / 充足留白防截断
 * ================================================================ */

QMainWindow, QWidget {
    background-color: #f2f5fa;
    color: #1e293b;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 14px;
}

/* ---------------- 标题 ---------------- */
QLabel#app_title {
    color: #0f172a;
    font-size: 23px;
    font-weight: 800;
    letter-spacing: 1px;
}
QLabel#app_subtitle {
    color: #64748b;
    font-size: 13px;
    min-width: 380px;
}
QLabel#device_pill {
    background-color: #e0f2fe;
    border: 1px solid #bae6fd;
    border-radius: 16px;
    padding: 8px 22px;
    color: #0369a1;
    font-weight: 600;
    font-size: 14px;
}

/* ---------------- 卡片 ---------------- */
QFrame#card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
}
QLabel#card_title {
    color: #475569;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    min-width: 120px;
}

/* ---------------- 模式选择 ---------------- */
QPushButton#mode_btn {
    background-color: #ffffff;
    border: 1px solid #dbe2ec;
    border-radius: 12px;
    padding: 10px 20px;
    color: #64748b;
    font-size: 14px;
    font-weight: 600;
}
QPushButton#mode_btn:hover {
    border-color: #94a3b8;
    color: #0f172a;
}
QPushButton#mode_btn:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0ea5e9, stop:1 #6366f1);
    border-color: transparent;
    color: #ffffff;
}

/* ---------------- 标签 ---------------- */
QLabel {
    color: #1e293b;
    font-size: 14px;
}
QLabel#stat {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 10px 18px;
    color: #0369a1;
    font-family: "Consolas", monospace;
    font-size: 13px;
}
QLabel#build_badge {
    background-color: #f1eaff;
    border: 1px solid #ddd0ff;
    border-radius: 8px;
    padding: 5px 14px;
    color: #6d28d9;
    font-family: "Consolas", monospace;
    font-size: 13px;
}
QLabel#dev_info {
    color: #059669;
    font-family: "Consolas", monospace;
    font-size: 13px;
}

/* ---------------- 输入控件 ---------------- */
QLineEdit, QComboBox, QSpinBox {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #d7dde8;
    border-radius: 10px;
    padding: 8px 14px;
    min-height: 22px;
    selection-background-color: #0ea5e9;
    font-size: 14px;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover {
    border-color: #94a3b8;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #0ea5e9;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border: none;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #d7dde8;
    selection-background-color: #e0f2fe;
    selection-color: #0f172a;
    outline: none;
}
QSpinBox::up-button, QSpinBox::down-button {
    width: 20px;
    background-color: #ffffff;
    border: none;
}

/* ---------------- 按钮 ---------------- */
QPushButton {
    background-color: #f1f5f9;
    color: #1e293b;
    border: 1px solid #d7dde8;
    border-radius: 10px;
    padding: 9px 20px;
    min-height: 22px;
    font-size: 14px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #e2e8f0;
    border-color: #94a3b8;
}
QPushButton:pressed {
    background-color: #cbd5e1;
}
QPushButton:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}
QPushButton#ghost {
    background-color: #ffffff;
    border: 1px solid #d7dde8;
    color: #475569;
}
QPushButton#ghost:hover {
    background-color: #f8fafc;
    color: #0f172a;
    border-color: #94a3b8;
}
QPushButton#primary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #10b981, stop:1 #0ea5e9);
    border: none;
    color: #ffffff;
    font-size: 16px;
    font-weight: 800;
    border-radius: 12px;
}
QPushButton#primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #34d399, stop:1 #38bdf8);
}
QPushButton#danger {
    background-color: #fee2e2;
    border-color: #fecaca;
    color: #b91c1c;
}
QPushButton#danger:hover {
    background-color: #fecaca;
}
QPushButton#batch {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #8b5cf6, stop:1 #ec4899);
    border: none;
    color: #ffffff;
    font-weight: 700;
}
QPushButton#batch:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #a78bfa, stop:1 #f472b6);
}

/* ---------------- 进度条 ---------------- */
QProgressBar {
    background-color: #eef2f7;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    text-align: center;
    color: #1e293b;
    font-weight: 700;
    font-size: 13px;
    min-height: 24px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0ea5e9, stop:1 #6366f1);
    border-radius: 9px;
}

/* ---------------- 阶段流程条 ---------------- */
QLabel#stage_seg {
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 11px 6px;
    color: #94a3b8;
    font-weight: 700;
    font-size: 13px;
}
QLabel#stage_seg[state="done"] {
    background: #d1fae5;
    border-color: #6ee7b7;
    color: #065f46;
}
QLabel#stage_seg[state="cur"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #38bdf8, stop:1 #818cf8);
    border-color: #60a5fa;
    color: #ffffff;
}
QLabel#stage_seg[state="fail"] {
    background-color: #fee2e2;
    border-color: #fca5a5;
    color: #b91c1c;
}

/* ---------------- 日志控制台 ---------------- */
QTextEdit {
    background-color: #f8fafc;
    color: #1e293b;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 13px;
    padding: 12px;
    selection-background-color: #bae6fd;
}

/* ---------------- 复选框 ---------------- */
QCheckBox {
    color: #475569;
    spacing: 8px;
    font-size: 13px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    background-color: #ffffff;
}
QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0ea5e9, stop:1 #6366f1);
    border-color: transparent;
}

/* ---------------- 滚动条 ---------------- */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 6px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* ---------------- 状态栏 ---------------- */
QStatusBar {
    background-color: #ffffff;
    color: #64748b;
    border-top: 1px solid #e2e8f0;
}
QStatusBar::item {
    border: none;
}

/* ---------------- 消息框 ---------------- */
QMessageBox {
    background-color: #ffffff;
}
QMessageBox QLabel {
    color: #1e293b;
    font-size: 14px;
}
