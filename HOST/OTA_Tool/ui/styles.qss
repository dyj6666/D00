/* ================================================================
 * D00 OTA 升级中心 · 暗色高端主题
 * 色板：深空蓝底 / 玻璃卡片 / 青蓝渐变主色 / 状态语义色
 * ================================================================ */

QMainWindow, QWidget {
    background-color: #0b1220;
    color: #cbd5e1;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* ---------------- 标题 ---------------- */
QLabel#app_title {
    color: #f1f5f9;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 1px;
}
QLabel#app_subtitle {
    color: #64748b;
    font-size: 12px;
}
QLabel#device_pill {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 14px;
    padding: 6px 16px;
    color: #38bdf8;
    font-weight: 600;
}

/* ---------------- 卡片 ---------------- */
QFrame#card {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 12px;
}
QLabel#card_title {
    color: #94a3b8;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
}

/* ---------------- 模式选择 ---------------- */
QPushButton#mode_btn {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 10px;
    padding: 10px 22px;
    color: #94a3b8;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#mode_btn:hover {
    border-color: #334155;
    color: #e2e8f0;
}
QPushButton#mode_btn:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0ea5e9, stop:1 #6366f1);
    border-color: transparent;
    color: #ffffff;
}

/* ---------------- 标签 ---------------- */
QLabel {
    color: #cbd5e1;
}
QLabel#stat {
    background-color: #0b1220;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 6px 14px;
    color: #38bdf8;
    font-family: "Consolas", monospace;
    font-size: 12px;
}
QLabel#build_badge {
    background-color: #1e293b;
    border-radius: 6px;
    padding: 2px 10px;
    color: #a78bfa;
    font-family: "Consolas", monospace;
}
QLabel#dev_info {
    color: #34d399;
    font-family: "Consolas", monospace;
    font-size: 12px;
}

/* ---------------- 输入控件 ---------------- */
QLineEdit, QComboBox, QSpinBox {
    background-color: #0b1220;
    color: #e2e8f0;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 7px 12px;
    selection-background-color: #0ea5e9;
    font-size: 13px;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover {
    border-color: #334155;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #0ea5e9;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    color: #475569;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
}
QComboBox QAbstractItemView {
    background-color: #0f172a;
    color: #e2e8f0;
    border: 1px solid #1e293b;
    selection-background-color: #1d4ed8;
    outline: none;
}
QSpinBox::up-button, QSpinBox::down-button {
    width: 18px;
    background-color: #0b1220;
    border: none;
}

/* ---------------- 按钮 ---------------- */
QPushButton {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #334155;
    border-color: #475569;
}
QPushButton:pressed {
    background-color: #1e293b;
}
QPushButton:disabled {
    background-color: #0f172a;
    color: #475569;
    border-color: #1e293b;
}
QPushButton#ghost {
    background-color: transparent;
    border: 1px solid #334155;
    color: #94a3b8;
}
QPushButton#ghost:hover {
    color: #e2e8f0;
    border-color: #64748b;
}
QPushButton#primary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #10b981, stop:1 #0ea5e9);
    border: none;
    color: #ffffff;
    font-size: 15px;
    font-weight: 800;
    border-radius: 10px;
}
QPushButton#primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #34d399, stop:1 #38bdf8);
}
QPushButton#danger {
    background-color: #7f1d1d;
    border-color: #991b1b;
    color: #fecaca;
}
QPushButton#danger:hover {
    background-color: #991b1b;
}
QPushButton#batch {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #8b5cf6, stop:1 #ec4899);
    border: none;
    color: #ffffff;
    font-weight: 700;
}
QPushButton#batch:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #a78bfa, stop:1 #f472b6);
}

/* ---------------- 进度条 ---------------- */
QProgressBar {
    background-color: #0b1220;
    border: 1px solid #1e293b;
    border-radius: 8px;
    text-align: center;
    color: #f1f5f9;
    font-weight: 700;
    height: 22px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0ea5e9, stop:1 #6366f1);
    border-radius: 7px;
}

/* ---------------- 阶段流程条 ---------------- */
QLabel#stage_seg {
    background-color: #0b1220;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 9px 4px;
    color: #64748b;
    font-weight: 700;
    font-size: 12px;
}
QLabel#stage_seg[state="done"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0f766e, stop:1 #065f46);
    border-color: #10b981;
    color: #d1fae5;
}
QLabel#stage_seg[state="cur"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0369a1, stop:1 #4338ca);
    border-color: #38bdf8;
    color: #ffffff;
}
QLabel#stage_seg[state="fail"] {
    background-color: #7f1d1d;
    border-color: #ef4444;
    color: #fee2e2;
}

/* ---------------- 日志控制台 ---------------- */
QTextEdit {
    background-color: #0b1220;
    color: #cbd5e1;
    border: 1px solid #1e293b;
    border-radius: 8px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    padding: 10px;
    selection-background-color: #1d4ed8;
}

/* ---------------- 复选框 ---------------- */
QCheckBox {
    color: #94a3b8;
    spacing: 7px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #475569;
    border-radius: 5px;
    background-color: #0b1220;
}
QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0ea5e9, stop:1 #6366f1);
    border-color: transparent;
}

/* ---------------- 滚动条 ---------------- */
QScrollBar:vertical {
    background: #0b1220;
    width: 10px;
    margin: 2px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #334155;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #475569;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* ---------------- 状态栏 ---------------- */
QStatusBar {
    background-color: #0f172a;
    color: #64748b;
}
QStatusBar::item {
    border: none;
}

/* ---------------- 消息框 ---------------- */
QMessageBox {
    background-color: #0f172a;
}
QMessageBox QLabel {
    color: #e2e8f0;
    font-size: 13px;
}
